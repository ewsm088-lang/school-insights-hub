        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "student_id": {
              "type": "string",
              "description": "ID do aluno."
            },
            "texto": {
              "type": "string",
              "minLength": 1,
              "description": "Texto da observação."
            }
          },
          "required": [
            "student_id",
            "texto"
          ]
